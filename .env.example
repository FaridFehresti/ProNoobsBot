DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_APPLICATION_ID=1575472988059607050
# Optional: guild commands update immediately in this server; omit to register globally.
DISCORD_GUILD_ID=830477450336665670

PRONOOBS_API_URL=https://api.example.com
PRONOOBS_API_KEY=your-backend-admin-api-key

# Optional comma-separated Discord role IDs allowed to run write commands.
# Discord server administrators can always run them.
DISCORD_ADMIN_ROLE_IDS=1187076129698365490

# General announcement channel; also used for successful-registration notices for now.
DISCORD_ANNOUNCEMENT_CHANNEL_ID=1540396583265239141
DISCORD_REGISTRATION_ANNOUNCEMENT_CHANNEL_ID=1540396583265239141
# Channel where members register or use the registration flow.
DISCORD_REGISTRATION_CHANNEL_ID=1540396648750911609

# Team communication category; used for both team text and voice channels.
DISCORD_TEAM_CATEGORY_ID=1574003539997499523
DISCORD_TEAM_CAPTAIN_ROLE_ID=
DISCORD_MMR_ALERT_CHANNEL_ID=
DISCORD_AUDIT_LOG_CHANNEL_ID=
# Blank means no channel allowlist (admins may target any channel the bot can access).
DISCORD_BROADCAST_CHANNEL_IDS=
# Optional role/user allowlists for targeted broadcasts.
DISCORD_BROADCAST_ROLE_IDS=
DISCORD_BROADCAST_USER_IDS=
# Optional separate categories; if blank, DISCORD_TEAM_CATEGORY_ID is used for both.
DISCORD_TEAM_TEXT_CATEGORY_ID=
DISCORD_TEAM_VOICE_CATEGORY_ID=
